{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "linux-debug",
            "displayName": "Linux Debug",
            "description": "Default build",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "linux-release",
            "displayName": "Linux Release",
            "description": "optimized build for distribution",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "windows-vs-debug",
            "displayName": "Windows Debug Visual Studio 2022",
            "description": "Build with Visual Studio (MSVC) in Debug Mode",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build/windows-vs",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "windows-vs-release",
            "displayName": "Windows Release Visual Studio 2022",
            "description": "Build with Visual Studio (MSVC)",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build/windows-vs",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "windows-mingw-debug",
            "displayName": "Windows MinGW Debug",
            "description": "Build with MinGW (GCC) in Debug Mode",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/windows-mingw-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_C_COMPILER": "gcc.exe",
                "CMAKE_CXX_COMPILER": "g++.exe"
            }
        },
        {
            "name": "windows-mingw-release",
            "displayName": "Windows MinGW Release",
            "description": "Build with MinGW (GCC) in Release Mode",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/windows-mingw-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_C_COMPILER": "gcc.exe",
                "CMAKE_CXX_COMPILER": "g++.exe"
            }
        },
                {
            "name": "windows-clang-debug",
            "displayName": "Windows Clang Debug",
            "description": "Build with Clang in Debug Mode",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/windows-clang-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_C_COMPILER": "clang.exe",
                "CMAKE_CXX_COMPILER": "clang++.exe"
            }
        },
        {
            "name": "windows-clang-release",
            "displayName": "Windows Clang Release",
            "description": "Build with Clang in Release Mode",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/windows-clang-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_C_COMPILER": "clang.exe",
                "CMAKE_CXX_COMPILER": "clang++.exe"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "linux-debug-build",
            "displayName": "Debug",
            "configurePreset": "linux-debug"
        },
        {
            "name": "linux-release-build",
            "displayName": "Release",
            "configurePreset": "linux-release"
        },
        {
            "name": "windows-vs-debug-build",
            "displayName": "Debug",
            "configurePreset": "windows-vs-debug"
        },
        {
            "name": "windows-vs-release-build",
            "displayName": "Release",
            "configurePreset": "windows-vs-release"
            
        },
        {
            "name": "windows-mingw-debug-build",
            "displayName": "Debug",
            "configurePreset": "windows-mingw-debug"
        },
        {
            "name": "windows-mingw-release-build",
            "displayName": "Release",
            "configurePreset": "windows-mingw-release"
        },
        {
            "name": "windows-clang-debug-build",
            "displayName": "Debug",
            "configurePreset": "windows-clang-debug"
        },
        {
            "name": "windows-clang-release-build",
            "displayName": "Release",
            "configurePreset": "windows-clang-release"
        }
    ]
}